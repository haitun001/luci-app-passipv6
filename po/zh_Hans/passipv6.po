msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_Hans\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "After upgrading or changing IPv6 permissions, reconnect affected devices once to refresh their network settings."
msgstr "升级或更改 IPv6 权限后，请将受影响的设备断开并重新连接一次，以刷新网络设置。"

msgid "IPv6 network settings could not be applied."
msgstr "IPv6 网络设置未能生效。"

msgid "Allow IPv6 Internet access"
msgstr "允许 IPv6 上网"

msgid "Application was cancelled or did not complete."
msgstr "应用已取消或未完成。"

msgid "Application was cancelled or rolled back."
msgstr "应用已取消或回滚。"

msgid "Device / MAC address"
msgstr "设备 / MAC 地址"

msgid "Devices refresh every 5 seconds. Offline allowlist entries are kept."
msgstr "设备列表每 5 秒刷新，离线设备的白名单会保留。"

msgid "Discovery status"
msgstr "发现状态"

msgid "IPv4 addresses"
msgstr "IPv4 地址"

msgid "IPv6 addresses"
msgstr "IPv6 地址"

msgid "IPv6 protection is active. Allowed devices: %s."
msgstr "IPv6 白名单保护已生效，允许 %s 台设备。"

msgid "IPv6 protection is not active."
msgstr "IPv6 白名单保护尚未启用。"

msgid "LAN devices and IPv6 Internet permissions"
msgstr "局域网设备与 IPv6 上网权限"

msgid "Lease or saved entry; presence unknown"
msgstr "租约或已保存设备；在线状态未知"

msgid "No devices have been discovered yet."
msgstr "暂未发现设备。"

msgid "Not known"
msgstr "尚未知晓"

msgid "Only selected devices may access other networks using IPv6. Communication between LAN devices and IPv4 remain available."
msgstr "只有勾选的设备可以通过 IPv6 访问其他网络。局域网设备之间的通信和 IPv4 继续可用。"

msgid "Permission denied."
msgstr "没有操作权限。"

msgid "Recently observed"
msgstr "近期发现"

msgid "Refresh failed. Your choices have been kept."
msgstr "刷新失败，已保留你的勾选。"

msgid "Reset"
msgstr "重置"

msgid "Save"
msgstr "保存"

msgid "Save & Apply"
msgstr "保存并应用"

msgid "Saved. Not yet applied."
msgstr "已保存，尚未应用。"

msgid "Saving and applying changes…"
msgstr "正在保存并应用更改…"

msgid "Saving changes…"
msgstr "正在保存更改…"

msgid "The operation did not complete."
msgstr "操作未完成。"

msgid "The operation result could not be confirmed."
msgstr "未能确认操作结果。"

msgid "The policy could not be applied. Check the error below."
msgstr "规则应用失败，请查看下方错误信息。"

msgid "Unknown device"
msgstr "未知设备"

msgid "Unsaved changes."
msgstr "有尚未保存的修改。"

msgid "Unselected devices may still have IPv6 addresses for local communication. These addresses do not grant access to other networks."
msgstr "未勾选的设备仍可能具有用于本地通信的 IPv6 地址，但不能据此访问其他网络。"
